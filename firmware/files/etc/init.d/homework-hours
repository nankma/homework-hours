#!/bin/sh /etc/rc.common

# After AdGuard Home (19) and the network
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/homework-hours -listen :8443 -data /etc/homework-hours
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
